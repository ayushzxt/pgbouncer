;; PgBouncer config template for the pool-sizing benchmark.
;; The harness (benchmark/run_matrix.py) substitutes __POOL_SIZE__ and writes this
;; to /etc/pgbouncer/pgbouncer.ini before restarting PgBouncer for each run.

[databases]
appdb = host=127.0.0.1 port=5432 dbname=appdb

[pgbouncer]
logfile = /var/log/postgresql/pgbouncer.log
pidfile = /var/run/postgresql/pgbouncer.pid
listen_addr = 127.0.0.1
listen_port = 6432
unix_socket_dir = /var/run/postgresql

auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
admin_users = appuser
stats_users = appuser

pool_mode = transaction
default_pool_size = __POOL_SIZE__
min_pool_size = 0
; high enough that PgBouncer never becomes the client-side bottleneck:
; the widest run is 4 instances x 40 Hikari connections = 160 clients
max_client_conn = 1000
; lets pgjdbc's prepared statements work in transaction mode (PgBouncer 1.21+)
max_prepared_statements = 100

ignore_startup_parameters = extra_float_digits,options
